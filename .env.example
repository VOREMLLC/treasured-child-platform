# ---- Backend ----
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/treasured_child
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
BOOTSTRAP_ADMIN_EMAIL=
# Outbound email over SMTP (465 = SSL, 587 = STARTTLS). Unset = not sent in production.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Inbox alerted when the AI tutor detects a learner in distress (falls back to ADMIN_EMAIL).
SAFEGUARDING_EMAIL=
ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Payments (Paystack) ----
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ---- AI agent runtime ----
ANTHROPIC_API_KEY=sk-ant-xxx
AGENT_MODEL=claude-sonnet-4-6

# ---- Frontend ----
# Website proxies /api/* to this backend URL (read at build time).
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
